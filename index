<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<title>For Nics</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..600;1,9..144,400..600&family=Newsreader:ital,opsz,wght@0,6..72,400..500;1,6..72,400..500&family=Pinyon+Script&display=swap">
<style>
/* Layout: a taped envelope on a lilac stage opens into a stack of slightly tilted white pages, joined by arrows made of silver diamonds. One committed look: purple and white. */
:root{
  --ink:#2a1a4a; --body:#3b2b5f; --soft:#6a5a90;
  --violet:#7a4fd8; --orchid:#a67fea; --lilac:#d9c9fc; --mist:#efe7ff; --veil:#f8f5ff; --paper:#ffffff;
  --silver:#c3c8d8; --silver-deep:#8c93ad;
  --f-display:'Fraunces','Iowan Old Style','Palatino Linotype',Georgia,serif;
  --f-body:'Newsreader','Iowan Old Style',Georgia,serif;
  --f-script:'Pinyon Script','Snell Roundhand','Brush Script MT',cursive;
  color-scheme:light;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0;background:var(--mist);color:var(--body);
  font-family:var(--f-body);font-size:1.15rem;line-height:1.7;
  padding-left:max(16px,env(safe-area-inset-left,0px));
  padding-right:max(16px,env(safe-area-inset-right,0px));
  padding-block:0 4rem;overflow-x:clip;-webkit-font-smoothing:antialiased;
}
body::before{
  content:"";position:fixed;inset:0;z-index:-1;
  background:
    radial-gradient(60% 50% at 12% 8%,#ffffff 0,transparent 62%),
    radial-gradient(50% 45% at 92% 22%,#cdb6fb 0,transparent 66%),
    radial-gradient(60% 50% at 68% 96%,#d9c9fc 0,transparent 62%),
    linear-gradient(180deg,#f3ecff,#e4d7fd);
}
:focus-visible{outline:3px solid var(--violet);outline-offset:4px;border-radius:4px}
button{font:inherit;color:inherit}

#fx{position:fixed;inset:0;width:100%;height:100%;z-index:40;pointer-events:none}

/* reading progress */
.prog{position:fixed;left:0;right:0;top:env(safe-area-inset-top,0px);height:3px;z-index:35;background:rgba(122,79,216,.14)}
.prog b{display:block;height:100%;width:calc(var(--sp,0)*100%);background:linear-gradient(90deg,var(--orchid),var(--violet))}
.prog i{position:absolute;top:50%;left:calc(var(--sp,0)*100%);width:14px;height:22px;translate:-50% -50%;
  background:linear-gradient(135deg,#fff,#a9b0c8 55%,#fff);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}

/* ---------- envelope stage ---------- */
.stage{
  position:fixed;inset:0;z-index:30;display:flex;overflow-x:hidden;overflow-y:auto;
  padding:max(1rem,env(safe-area-inset-top,0px)) max(16px,env(safe-area-inset-right,0px)) max(1rem,env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px));
  background:
    radial-gradient(70% 55% at 18% 10%,#ffffff 0,transparent 62%),
    radial-gradient(60% 50% at 90% 88%,#c4a9f9 0,transparent 66%),
    linear-gradient(170deg,#ebe0ff,#cdb6fb);
  transition:opacity .7s ease;
}
.stage.leaving{opacity:0;pointer-events:none}
.stage-in{margin:auto;display:flex;flex-direction:column;align-items:center;gap:1.4rem;width:100%;padding-block:1rem}
.eyebrow{margin:0;font-size:.74rem;letter-spacing:.26em;text-transform:uppercase;color:var(--ink);transition:opacity .4s}
.hintrow{display:flex;align-items:center;gap:.7rem;transition:opacity .4s}
.hint{margin:0;font-style:italic;color:var(--ink);font-size:1.05rem}
.hint-arrow{width:44px;flex:none}
.hint-arrow .arrow-svg{rotate:-90deg}
.skip{background:none;border:0;padding:.3rem .5rem;cursor:pointer;color:var(--ink);font-size:.95rem;text-decoration:underline;text-decoration-color:var(--orchid);text-underline-offset:5px;transition:opacity .4s}
.stage.opening .eyebrow,.stage.opening .hintrow,.stage.opening .skip{opacity:0}

.env{position:relative;width:min(88vw,540px);aspect-ratio:3/2;perspective:1400px;margin-top:clamp(3rem,14vw,6rem)}
.env.idle{animation:bob 5s ease-in-out infinite}
@keyframes bob{50%{translate:0 -8px}}
.env-back{position:absolute;inset:0;z-index:1;border-radius:5px;background:linear-gradient(180deg,#e4d6fc,#d6c2fa);box-shadow:0 34px 50px -24px rgba(60,30,130,.65)}
.paper{
  position:absolute;left:6%;right:6%;top:5%;height:88%;z-index:3;background:#fff;border-radius:3px;
  box-shadow:0 0 0 1px rgba(122,79,216,.14);padding:7% 8%;
  transition:transform 1.05s cubic-bezier(.2,.8,.2,1) .55s;
}
.env.open .paper{transform:translateY(-64%)}
.paper .to{font-family:var(--f-script);font-size:clamp(1.7rem,6.4vw,2.5rem);color:var(--violet);line-height:1}
.paper .ln{height:5px;border-radius:3px;background:var(--mist);margin-top:.8rem}
.front{position:absolute;inset:0;width:100%;height:100%;z-index:4;pointer-events:none}
.to-nics{position:absolute;left:50%;top:77%;translate:-50% -50%;z-index:5;white-space:nowrap;pointer-events:none;
  font-family:var(--f-script);font-size:clamp(2rem,8.4vw,3.2rem);line-height:1;color:var(--violet);text-shadow:0 1px 0 #fff}
.flap{position:absolute;left:0;top:0;width:100%;height:60%;z-index:5;transform-origin:50% 0;transform-style:preserve-3d}
.flap>svg{position:absolute;inset:0;width:100%;height:100%;backface-visibility:hidden;-webkit-backface-visibility:hidden}
.flap .fb{transform:rotateX(180deg)}
.flap .jewel{inset:auto;left:50%;top:70%;width:11%;height:auto;translate:-50% -50%;filter:drop-shadow(0 3px 3px rgba(60,30,130,.35))}
.env.open .flap{animation:flapOpen .9s ease-in-out .1s forwards}
@keyframes flapOpen{
  0%{transform:rotateX(0deg);z-index:5}
  49%{z-index:5}
  50%{z-index:2}
  100%{transform:rotateX(-180deg);z-index:2}
}
.tape{
  position:absolute;left:0;width:100%;top:4%;height:10%;z-index:6;border-radius:2px;
  background:
    repeating-linear-gradient(135deg,rgba(255,255,255,.4) 0 5px,transparent 5px 12px),
    linear-gradient(180deg,#d2bcfb,#b896f3);
  box-shadow:inset 0 0 0 1px rgba(122,79,216,.28),0 3px 7px -2px rgba(50,25,110,.35);
}
.tape::after{content:"";position:absolute;left:0;right:0;top:50%;border-top:2px dashed rgba(42,26,74,.6)}
.tape.a{clip-path:inset(0 calc((1 - var(--p,.24))*100%) 0 0)}
.tape.a::after{display:none}
.tape.b{clip-path:inset(0 0 0 calc(var(--p,.24)*100% + 3px))}
.tape.a.fall{transform-origin:0 50%;animation:fallA 1s cubic-bezier(.5,0,.9,.6) forwards}
.tape.b.fall{transform-origin:100% 50%;animation:fallB 1s cubic-bezier(.5,0,.9,.6) forwards}
@keyframes fallA{to{transform:translate(-8%,340%) rotate(-24deg);opacity:0}}
@keyframes fallB{to{transform:translate(8%,360%) rotate(22deg);opacity:0}}

.handle{
  position:absolute;top:9%;left:calc(var(--p,.24)*100%);translate:-100% -50%;z-index:8;
  width:clamp(56px,15vw,78px);cursor:grab;touch-action:none;
  filter:drop-shadow(0 4px 5px rgba(50,25,110,.4));
}
.handle::before{content:"";position:absolute;inset:-10px}
.handle:active{cursor:grabbing}
.handle svg{display:block;width:100%;height:auto;overflow:visible}
.handle .bl{transform-box:view-box;transform-origin:30px 22px}
.handle .bl.a{transform:rotate(-4deg)}
.handle .bl.b{transform:rotate(4deg)}
.handle.snip .bl.a{animation:snipA .16s ease-in-out infinite alternate}
.handle.snip .bl.b{animation:snipB .16s ease-in-out infinite alternate}
@keyframes snipA{from{transform:rotate(-14deg)}to{transform:rotate(-1deg)}}
@keyframes snipB{from{transform:rotate(14deg)}to{transform:rotate(1deg)}}
.handle.gone{animation:flyoff .7s ease-in forwards;pointer-events:none}
@keyframes flyoff{to{translate:-20% -320%;rotate:24deg;opacity:0}}

/* ---------- letter ---------- */
main{max-width:56rem;margin:0 auto}
.hero{position:relative;max-width:40rem;margin:0 auto;padding-block:clamp(3.5rem,10vh,6rem) 1rem;text-align:center;display:flex;flex-direction:column;align-items:center;gap:.5rem}
.kicker{margin:0;font-size:.74rem;letter-spacing:.24em;text-transform:uppercase;color:var(--violet)}
h1{margin:.05em 0 0;font-family:var(--f-script);font-weight:400;font-size:clamp(4.8rem,23vw,9.5rem);line-height:1;color:var(--violet);
  text-shadow:0 2px 0 #fff,0 14px 34px rgba(122,79,216,.35)}
.sub{margin:0;font-family:var(--f-display);font-style:italic;font-size:1.3rem;color:var(--ink)}
.gem{position:absolute;width:26px;aspect-ratio:1;background:linear-gradient(135deg,#fff,#aeb5cc 55%,#fff);
  clip-path:polygon(50% 0,60% 40%,100% 50%,60% 60%,50% 100%,40% 60%,0 50%,40% 40%);animation:twinkle 2.6s ease-in-out infinite}
.gem.g1{left:8%;top:34%}
.gem.g2{right:7%;top:26%;width:34px;animation-delay:.7s}
.gem.g3{right:16%;bottom:24%;width:20px;animation-delay:1.3s}
.gem.g4{left:19%;bottom:18%;width:16px;animation-delay:.3s}
@keyframes twinkle{0%,100%{opacity:.5;scale:.85}50%{opacity:1;scale:1.25}}

.pages{display:flex;flex-direction:column;align-items:stretch;gap:.4rem;padding-top:.5rem}
.sheet{
  position:relative;width:min(100%,38rem);background:var(--paper);border-radius:3px;scroll-margin-top:1.5rem;
  padding:clamp(1.8rem,5.5vw,3.1rem) clamp(1.4rem,5.5vw,3rem) clamp(1.6rem,5vw,2.8rem);
  box-shadow:0 1px 0 rgba(122,79,216,.12),0 30px 50px -28px rgba(70,35,150,.5),0 6px 14px -8px rgba(70,35,150,.25);
  transition:rotate .5s cubic-bezier(.2,.8,.2,1);
}
.sheet.l{align-self:flex-start;rotate:-.5deg}
.sheet.r{align-self:flex-end;rotate:.6deg}
@media (hover:hover){.sheet:hover{rotate:0deg}}
.sheet .bit{
  position:absolute;top:-13px;left:50%;width:96px;height:26px;translate:-50% 0;rotate:-3deg;
  background:
    repeating-linear-gradient(45deg,rgba(255,255,255,.4) 0 4px,transparent 4px 9px),
    linear-gradient(180deg,rgba(194,166,247,.92),rgba(166,127,234,.92));
  box-shadow:0 2px 5px -2px rgba(50,25,110,.35);
}
.sheet.r .bit{rotate:3deg;left:42%}
.sheet.l .bit{left:58%}
.label{margin:0 0 .9rem;font-size:.74rem;letter-spacing:.22em;text-transform:uppercase;color:var(--violet);line-height:1}
.label::before{content:"";display:inline-block;width:.6em;height:.9em;margin-right:.7em;vertical-align:-.12em;
  background:linear-gradient(135deg,#fff,#a9b0c8 55%,#fff);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%)}
h2{margin:0 0 1.1rem;font-family:var(--f-display);font-weight:500;font-size:clamp(1.9rem,6vw,2.6rem);line-height:1.1;letter-spacing:-.01em;color:var(--ink);text-wrap:balance}
.sheet p{margin:0 0 1.1em;max-width:34rem}
.sheet p:last-child{margin-bottom:0}
.pull{
  position:relative;margin:1.7rem 0 1.5rem;padding-left:1.7rem;
  font-family:var(--f-display);font-style:italic;font-weight:400;font-size:clamp(1.5rem,5vw,2rem);line-height:1.25;color:var(--violet);text-wrap:balance;
}
.pull::before{content:"";position:absolute;left:0;top:.38em;width:.85rem;height:1.3rem;
  background:linear-gradient(135deg,#fff,#a9b0c8 55%,#fff);clip-path:polygon(50% 0,100% 50%,50% 100%,0 50%);animation:twinkle 3s ease-in-out infinite}

.arrow{align-self:center;width:92px;aspect-ratio:100/96;padding:0;border:0;background:none;cursor:pointer;margin-block:.4rem}
.arrow-svg{display:block;width:100%;height:auto;overflow:visible;filter:drop-shadow(0 1px 2px rgba(80,40,160,.4))}
.arrow .arrow-svg{animation:float 2.6s ease-in-out infinite}
@keyframes float{50%{translate:0 5px}}
.tw{transform-box:fill-box;transform-origin:center;animation:tw 2.2s ease-in-out infinite;animation-delay:calc(var(--i,0)*.19s)}
@keyframes tw{0%,100%{opacity:.6;transform:scale(.9)}50%{opacity:1;transform:scale(1.35)}}
.arrow:hover .tw{animation-duration:.9s}

.sig{margin-top:1.6rem}
.sig em{display:block;font-size:1.05rem;color:var(--soft)}
.sig .script{font-family:var(--f-script);font-size:3.2rem;line-height:1.1;color:var(--violet)}
.wish{
  display:inline-flex;align-items:center;gap:.7rem;margin-top:1.4rem;padding:.8rem 1.4rem;border-radius:999px;cursor:pointer;
  border:1.5px solid var(--violet);background:linear-gradient(180deg,#fff,var(--mist));color:var(--violet);
  font-size:1.02rem;letter-spacing:.05em;box-shadow:0 10px 22px -12px rgba(122,79,216,.8);
  transition:background .25s,color .25s,translate .25s;
}
.wish:hover{background:var(--violet);color:#fff;translate:0 -2px}
.wish svg{width:16px;height:22px;flex:none}
.wish-out{margin-top:1.2rem;min-height:6.5rem}
.wish-out .big{font-family:var(--f-script);font-size:clamp(2.7rem,10vw,3.7rem);line-height:1.1;color:var(--violet)}
.wish-out p{margin:.2rem 0 0;font-style:italic;color:var(--soft)}

.foot{margin:3rem auto 0;text-align:center;font-size:.92rem;color:var(--soft)}
.foot p{margin:0 0 .4rem}
.again{background:none;border:0;cursor:pointer;color:var(--violet);padding:.3rem .5rem;text-decoration:underline;text-decoration-color:var(--orchid);text-underline-offset:5px}

.sheet.in,.arrow.in{animation:rise .9s cubic-bezier(.2,.7,.2,1) both}
@keyframes rise{from{opacity:0;translate:0 26px}to{opacity:1;translate:0 0}}
.hero>*{animation:rise 1s cubic-bezier(.2,.7,.2,1) both}
.hero>*:nth-child(2){animation-delay:.12s}
.hero>*:nth-child(3){animation-delay:.24s}

@media (max-width:540px){
  .sheet.l,.sheet.r{align-self:stretch;width:100%}
  .sheet.l{rotate:-.3deg}.sheet.r{rotate:.3deg}
  .gem.g1{left:2%}.gem.g2{right:2%}
}
@media (prefers-reduced-motion:reduce){
  html{scroll-behavior:auto}
  *,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;transition-delay:0s!important;animation-delay:0s!important}
}
</style>

<style>[hidden]{display:none!important}</style>
</head>
<body>
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="silver" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#ffffff"/><stop offset=".42" stop-color="#c9cee0"/><stop offset=".58" stop-color="#f3f5fb"/><stop offset="1" stop-color="#a7aec6"/>
    </linearGradient>
    <linearGradient id="flapf" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff"/><stop offset="1" stop-color="#f0e7ff"/>
    </linearGradient>
    <pattern id="diapat" width="3" height="4" patternUnits="userSpaceOnUse">
      <path d="M1.5 .35 L2.5 2 L1.5 3.65 L.5 2Z" fill="rgba(255,255,255,.3)"/>
    </pattern>
  </defs>
</svg>

<canvas id="fx" aria-hidden="true"></canvas>

<div class="prog" hidden><b></b><i></i></div>

<div class="stage" id="stage">
  <div class="stage-in">
    <p class="eyebrow">best opened with scissors</p>

    <div class="env idle" id="env" style="--p:.24">
      <div class="env-back"></div>
      <div class="paper" id="paper">
        <div class="to">for Nics</div>
        <div class="ln" style="width:92%"></div>
        <div class="ln" style="width:78%"></div>
        <div class="ln" style="width:86%"></div>
        <div class="ln" style="width:44%"></div>
      </div>
      <svg class="front" viewBox="0 0 100 66.667" preserveAspectRatio="none" aria-hidden="true">
        <polygon points="0,0 50,35 0,66.667" fill="#f7f2ff" stroke="#d3c1f8" stroke-width="1" vector-effect="non-scaling-stroke"/>
        <polygon points="100,0 50,35 100,66.667" fill="#f1e9ff" stroke="#d3c1f8" stroke-width="1" vector-effect="non-scaling-stroke"/>
        <polygon points="0,66.667 50,35 100,66.667" fill="#ffffff" stroke="#d3c1f8" stroke-width="1" vector-effect="non-scaling-stroke"/>
      </svg>
      <div class="to-nics" aria-hidden="true">for Nics</div>
      <div class="flap" id="flap">
        <svg class="ff" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
          <polygon points="0,0 100,0 50,40" fill="url(#flapf)" stroke="#cdb9f7" stroke-width="1.2" vector-effect="non-scaling-stroke"/>
        </svg>
        <svg class="fb" viewBox="0 0 100 40" preserveAspectRatio="none" aria-hidden="true">
          <polygon points="0,0 100,0 50,40" fill="#b693f0"/>
          <polygon points="0,0 100,0 50,40" fill="url(#diapat)" stroke="#8b63dd" stroke-width="1.2" vector-effect="non-scaling-stroke"/>
        </svg>
        <svg class="jewel" viewBox="0 0 40 56" aria-hidden="true">
          <polygon points="20,2 38,28 20,54 2,28" fill="url(#silver)" stroke="#8c93ad" stroke-width="1.2"/>
          <path d="M2 28 H38 M20 2 L13 28 L20 54 M20 2 L27 28 L20 54" fill="none" stroke="#fff" stroke-opacity=".85" stroke-width="1"/>
        </svg>
      </div>
      <div class="tape a"></div>
      <div class="tape b"></div>
      <div class="handle" id="handle" role="slider" tabindex="0"
           aria-label="Scissors. Drag right along the dotted line, or press the right arrow key, to cut the tape."
           aria-valuemin="0" aria-valuemax="100" aria-valuenow="0">
        <svg viewBox="0 0 72 44" aria-hidden="true">
          <g class="bl a">
            <path d="M22 20 L69 21.6 L69 22.4 L22 24Z" fill="url(#silver)" stroke="#8c93ad" stroke-width=".6"/>
            <path d="M19 14 L30 22" stroke="#7a4fd8" stroke-width="3.4" stroke-linecap="round"/>
            <circle cx="13" cy="10.5" r="7.2" fill="none" stroke="#7a4fd8" stroke-width="3.2"/>
          </g>
          <g class="bl b">
            <path d="M22 20 L69 21.6 L69 22.4 L22 24Z" fill="url(#silver)" stroke="#8c93ad" stroke-width=".6"/>
            <path d="M19 30 L30 22" stroke="#7a4fd8" stroke-width="3.4" stroke-linecap="round"/>
            <circle cx="13" cy="33.5" r="7.2" fill="none" stroke="#7a4fd8" stroke-width="3.2"/>
          </g>
        </svg>
      </div>
    </div>

    <div class="hintrow">
      <span class="hint-arrow" id="hintArrow"></span>
      <p class="hint">Slide the scissors along the dotted line.</p>
    </div>
    <button class="skip" id="skip" type="button">or just open it</button>
  </div>
</div>

<main id="letter" hidden>
  <header class="hero">
    <h1>for Nics</h1>
    <p class="sub">happy birthday, bestie</p>
    <span class="gem g1" aria-hidden="true"></span><span class="gem g2" aria-hidden="true"></span>
    <span class="gem g3" aria-hidden="true"></span><span class="gem g4" aria-hidden="true"></span>
  </header>
  <div style="display:flex;justify-content:center"><button class="arrow" data-next="s1" aria-label="Start reading"></button></div>

  <div class="pages">
    <section class="sheet l" id="s1">
      <span class="bit" aria-hidden="true"></span>
      <h2>I don&rsquo;t know where to begin.</h2>
      <p>I&rsquo;ve been sitting here editing your birthday greeting for my IG story, scrolling through my camera roll, and something caught me off guard. There are so many photos of us this year. Like, <em>so many</em>. Us at FEU, us being ridiculous, us looking tired and happy at the same time.</p>
      <p>Somewhere between the first photo and the last, I realized we might be making up for the time we lost, back when we were definitely &ldquo;not okay.&rdquo; That &ldquo;awkward stage&rdquo; where we orbited each other and never quite landed. Wow. Look at us now.</p>
      <p>Funny how that works. We went from not talking to always being together, lmao. No one could have told me that the careful distance between us would turn into this.</p>
      <blockquote class="pull">I am always grateful to have known you.</blockquote>
    </section>

    <button class="arrow" data-next="s2" aria-label="Next page: one call away"></button>

    <section class="sheet r" id="s2">
      <span class="bit" aria-hidden="true"></span>
      <p class="label">one call away</p>
      <h2>Thank you for always being there.</h2>
      <p>In the way that doesn&rsquo;t ask for an explanation. I know I can rely on you. I know it the way I know my own name. And I appreciate every single thing, the big ones and the small ones, the ones you did on purpose and the ones you probably don&rsquo;t even remember doing.</p>
      <blockquote class="pull">You became my one-call-away type of bestie.</blockquote>
      <p>We lived so much this year. From not talking to always being together. I still can&rsquo;t get over that, lmao.</p>
    </section>

    <button class="arrow" data-next="s3" aria-label="Next page: FEU, after hours"></button>

    <section class="sheet l" id="s3">
      <span class="bit" aria-hidden="true"></span>
      <p class="label">FEU, after hours</p>
      <h2>I will miss our night talks.</h2>
      <p>Afternoon melting into evening, evening melting into night, and the two of us still sitting there, talking, refusing to go home until the guards were already roaming. We never wanted the day to end because the talking never felt finished. I will miss that. I&rsquo;ll miss the shared moments, the corners of campus that now belong to us.</p>
      <blockquote class="pull">The talking never felt finished.</blockquote>
      <p>But I&rsquo;m not sad about it, not really. I can&rsquo;t wait to see us grow, each taking the path we decided to go, even when the paths look different. I hope we stay besties for the rest of our lives. I mean that in the plainest, most honest way I know how.</p>
      <p>And know this: you can always count on me. Ask me to join you on anything and I&rsquo;ll show up. I&rsquo;ll ask you to join my sidequests too, even if you&rsquo;re not available, and you can just say no, HAHAHAHAHA. That&rsquo;s the beauty of it. No pressure, only the open door.</p>
    </section>

    <button class="arrow" data-next="s4" aria-label="Next page: about you"></button>

    <section class="sheet r" id="s4">
      <span class="bit" aria-hidden="true"></span>
      <p class="label">about you</p>
      <h2>This part is for you.</h2>
      <p>I don&rsquo;t want this letter to be about our friendship, not mostly. I want it to be about you.</p>
      <p>You are such a lovable human being, and I know people find it so easy to love you. You may seem like the quiet one, and yes, you are, lmao. But you&rsquo;re also the talkative one, and I&rsquo;m grateful I get to see both sides of you. The soft silence and the loud laughter. They&rsquo;re both you, and they&rsquo;re both wonderful.</p>
      <blockquote class="pull">You are strong. You are enough.</blockquote>
      <p>Maybe not to everyone who rushes past, but to the people who have eyes to see. I can&rsquo;t wait to watch you strive and bloom, not just in your career, but in life itself. In the mornings you wake up lighter. In the rooms where you finally believe you belong. In every version of you that&rsquo;s still on its way.</p>
    </section>

    <button class="arrow" data-next="s5" aria-label="Next page: make a wish"></button>

    <section class="sheet l" id="s5">
      <span class="bit" aria-hidden="true"></span>
      <p class="label">make a wish</p>
      <h2>Happy, happy birthday, Nics.</h2>
      <p>Enjoy the rest of today. Enjoy the rest of the week. Enjoy the whole month, because it is yours to take. Take up space in it. Be celebrated in it.</p>
      <blockquote class="pull">I love you so much.</blockquote>
      <div class="sig"><em>your bestie, always,</em><span class="script">Ja</span></div>
      <button class="wish" id="wish" type="button">
        <svg viewBox="0 0 40 56" aria-hidden="true"><polygon points="20,2 38,28 20,54 2,28" fill="url(#silver)" stroke="#8c93ad" stroke-width="2"/></svg>
        <span>Make a wish</span>
      </button>
      <div class="wish-out" id="wishOut" aria-live="polite"></div>
    </section>
  </div>

  <footer class="foot">
    <p>Made for Nics, on her day.</p>
    <button class="again" id="again" type="button">seal it up and open it again</button>
  </footer>
</main>

<script>
(function(){
  var RM = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var T = RM ? 0.05 : 1;
  function $(s,r){return (r||document).querySelector(s)}
  function $$(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s))}
  function rand(a,b){return a+Math.random()*(b-a)}

  /* ---------- sparkle canvas ---------- */
  var cv=$('#fx'), cx=cv.getContext('2d');
  var W=0,H=0,dpr=1,parts=[],amb=[],running=false,last=0;
  function size(){
    dpr=Math.min(window.devicePixelRatio||1,2); W=window.innerWidth; H=window.innerHeight;
    cv.width=Math.round(W*dpr); cv.height=Math.round(H*dpr); cx.setTransform(dpr,0,0,dpr,0,0);
  }
  function seedAmb(){
    amb.length=0; var n=W<600?16:30;
    for(var i=0;i<n;i++) amb.push({x:rand(0,W),y:rand(0,H),r:rand(2,5),t:rand(0,6.28),sp:rand(.5,1.4),vy:-rand(.04,.16),vx:rand(-.05,.05),k:Math.random()<.45?1:0,rot:rand(-.4,.4)});
  }
  function draw(k,x,y,r,rot,a,glow){
    cx.save(); cx.translate(x,y); cx.rotate(rot); cx.globalAlpha=Math.max(0,Math.min(1,a));
    cx.shadowColor=glow?'rgba(122,79,216,.55)':'rgba(255,255,255,.9)'; cx.shadowBlur=glow?8:6;
    var g=cx.createLinearGradient(-r,-r*1.5,r,r*1.5);
    g.addColorStop(0,'#ffffff'); g.addColorStop(.42,'#c4c9db'); g.addColorStop(.58,'#f4f6fb'); g.addColorStop(1,'#a9b0c7');
    cx.beginPath();
    if(k===0){ cx.moveTo(0,-r*1.5); cx.lineTo(r,0); cx.lineTo(0,r*1.5); cx.lineTo(-r,0); cx.closePath(); }
    else { for(var i=0;i<8;i++){ var an=i*Math.PI/4-Math.PI/2, rr=i%2?r*.28:r*1.25; var px=Math.cos(an)*rr, py=Math.sin(an)*rr; if(i) cx.lineTo(px,py); else cx.moveTo(px,py); } cx.closePath(); }
    cx.fillStyle=g; cx.fill(); cx.shadowBlur=0; cx.lineWidth=.8; cx.strokeStyle='#98a0bb'; cx.stroke();
    if(k===0){ cx.beginPath(); cx.moveTo(-r,0); cx.lineTo(r,0); cx.strokeStyle='rgba(255,255,255,.7)'; cx.stroke(); }
    cx.restore();
  }
  function frame(now){
    var dt=Math.min(.05,(now-last)/1000); last=now; var kk=dt*60;
    cx.clearRect(0,0,W,H);
    for(var i=0;i<amb.length;i++){
      var a=amb[i];
      if(!RM){ a.t+=dt*a.sp; a.x+=a.vx*kk; a.y+=a.vy*kk; if(a.y<-20){a.y=H+20;a.x=rand(0,W);} }
      var tw=.25+.75*Math.abs(Math.sin(a.t*1.6));
      draw(a.k,a.x,a.y,a.r*(.7+.5*tw),a.rot,tw*.85,0);
    }
    for(var j=parts.length-1;j>=0;j--){
      var p=parts[j]; p.life-=dt;
      if(p.life<=0){parts.splice(j,1);continue;}
      p.vy+=p.g*kk; p.x+=p.vx*kk; p.y+=p.vy*kk; p.vx*=.992; p.rot+=p.spin*kk;
      draw(p.k,p.x,p.y,p.r,p.rot,Math.min(1,p.life/p.max*1.6),1);
    }
    if(!RM || parts.length){ requestAnimationFrame(frame); } else { running=false; }
  }
  function kick(){ if(!running){ running=true; last=performance.now(); requestAnimationFrame(frame); } }
  function burst(x,y,n,power){
    if(RM) return; power=power||1;
    for(var i=0;i<n;i++){
      var ang=rand(0,6.283), sp=rand(1.2,4.6)*power;
      parts.push({x:x,y:y,vx:Math.cos(ang)*sp,vy:Math.sin(ang)*sp-1.2,g:.07,r:rand(2.2,5.8),k:Math.random()<.5?1:0,rot:rand(0,3),spin:rand(-.08,.08),life:rand(.9,1.7),max:1.7});
    }
    kick();
  }
  function rain(ms){
    if(RM) return; var end=performance.now()+ms;
    (function tick(){
      if(performance.now()>end) return;
      for(var i=0;i<3;i++) parts.push({x:rand(0,W),y:-10,vx:rand(-.5,.5),vy:rand(1.2,3),g:.01,r:rand(2.5,6),k:Math.random()<.5?1:0,rot:rand(0,3),spin:rand(-.06,.06),life:rand(2.2,3.6),max:3.6});
      kick(); setTimeout(tick,70);
    })();
  }
  size(); seedAmb(); kick();
  window.addEventListener('resize',function(){ size(); seedAmb(); if(RM) kick(); });
  window.addEventListener('pointerdown',function(e){ burst(e.clientX,e.clientY,10,.7); },{passive:true});
  var lastTrail=0;
  window.addEventListener('pointermove',function(e){
    if(e.pointerType!=='mouse'||RM) return;
    var n=performance.now(); if(n-lastTrail<45) return; lastTrail=n;
    parts.push({x:e.clientX+rand(-4,4),y:e.clientY+rand(-4,4),vx:rand(-.3,.3),vy:rand(.2,.8),g:.02,r:rand(1.6,3.4),k:1,rot:rand(0,3),spin:rand(-.05,.05),life:rand(.5,.9),max:.9});
    kick();
  },{passive:true});

  /* ---------- silver diamond arrows ---------- */
  function dia(r){ return 'M0 '+(-r*1.5)+' L'+r+' 0 L0 '+(r*1.5)+' L'+(-r)+' 0Z'; }
  function starPath(r){
    var d=''; for(var i=0;i<8;i++){ var a=i*Math.PI/4-Math.PI/2, rr=i%2?r*.3:r; d+=(i?'L':'M')+(Math.cos(a)*rr).toFixed(2)+' '+(Math.sin(a)*rr).toFixed(2); }
    return d+'Z';
  }
  function makeArrow(host){
    var P0=[50,4],P1=[88,16],P2=[12,40],P3=[50,58], pts=[];
    [.07,.2,.34,.48,.62,.76,.9,1].forEach(function(t){
      var u=1-t;
      pts.push([u*u*u*P0[0]+3*u*u*t*P1[0]+3*u*t*t*P2[0]+t*t*t*P3[0], u*u*u*P0[1]+3*u*u*t*P1[1]+3*u*t*t*P2[1]+t*t*t*P3[1]]);
    });
    pts.push([50,67]);
    var s='<svg class="arrow-svg" viewBox="0 0 100 96" aria-hidden="true" focusable="false">';
    pts.forEach(function(q,i){
      s+='<g transform="translate('+q[0].toFixed(1)+' '+q[1].toFixed(1)+')"><path class="tw" style="--i:'+i+'" d="'+dia(2.1+i*.2)+'" fill="url(#silver)" stroke="#8c93ad" stroke-width=".7"/></g>';
    });
    [[50,88,5.4,9],[41,78,3.4,10],[59,78,3.4,11]].forEach(function(h){
      s+='<g transform="translate('+h[0]+' '+h[1]+')"><path class="tw" style="--i:'+h[3]+'" d="'+dia(h[2])+'" fill="url(#silver)" stroke="#8c93ad" stroke-width=".8"/></g>';
    });
    [[20,26,3.2,2],[82,30,2.6,5],[66,52,2.2,8]].forEach(function(h){
      s+='<g transform="translate('+h[0]+' '+h[1]+')"><path class="tw" style="--i:'+h[3]+'" d="'+starPath(h[2])+'" fill="#ffffff" stroke="#9aa1bb" stroke-width=".5"/></g>';
    });
    host.insertAdjacentHTML('beforeend',s+'</svg>');
  }
  makeArrow($('#hintArrow'));
  $$('.arrow').forEach(function(b){
    makeArrow(b);
    b.addEventListener('click',function(){
      var t=document.getElementById(b.dataset.next);
      if(t) t.scrollIntoView({behavior:RM?'auto':'smooth',block:'start'});
      var r=b.getBoundingClientRect(); burst(r.left+r.width/2,r.top+r.height*.8,14,.8);
    });
  });

  /* ---------- envelope ---------- */
  var stage=$('#stage'), env=$('#env'), handle=$('#handle'), main=$('#letter'), paper=$('#paper'), prog=$('.prog');
  var tapeA=$('.tape.a'), tapeB=$('.tape.b');
  var P0v=.24, p=P0v, done=false, auto=false, drag=null, tl=0, timers=[];
  function later(fn,ms){ timers.push(setTimeout(fn,ms)); }
  function setP(v){
    p=Math.max(p,Math.min(1,v));
    env.style.setProperty('--p',p);
    handle.setAttribute('aria-valuenow',String(Math.round((p-P0v)/(1-P0v)*100)));
  }
  function tipSpark(){
    var n=performance.now(); if(n-tl<50) return; tl=n;
    var r=env.getBoundingClientRect(); burst(r.left+p*r.width,r.top+.09*r.height,3,.5);
  }
  function complete(){
    if(done) return; done=true; setP(1);
    handle.classList.remove('snip'); handle.classList.add('gone'); stage.classList.add('opening');
    later(function(){ tapeA.classList.add('fall'); tapeB.classList.add('fall'); },150*T);
    later(function(){ env.classList.add('open'); },450*T);
    later(function(){ var r=paper.getBoundingClientRect(); burst(r.left+r.width/2,r.top+12,28,1.1); },1500*T);
    later(reveal,2300*T);
  }
  function autoCut(){
    if(done||auto) return; auto=true; env.classList.remove('idle'); handle.classList.add('snip');
    var s=p, t0=performance.now(), d=Math.max(30,(750*(1-s)/(1-P0v)+200)*T);
    (function step(n){
      var k=Math.min(1,(n-t0)/d); setP(s+(1-s)*k); tipSpark();
      if(k<1) requestAnimationFrame(step); else complete();
    })(t0);
  }
  handle.addEventListener('pointerdown',function(e){
    if(done||auto) return; e.preventDefault();
    try{ handle.setPointerCapture(e.pointerId); }catch(_){}
    drag={x:e.clientX,p0:p}; handle.classList.add('snip'); env.classList.remove('idle');
  });
  handle.addEventListener('pointermove',function(e){
    if(!drag||done) return;
    var w=env.getBoundingClientRect().width; setP(drag.p0+(e.clientX-drag.x)/w); tipSpark();
    if(p>=.985) complete();
  });
  function endDrag(){ drag=null; if(!done&&!auto) handle.classList.remove('snip'); }
  handle.addEventListener('pointerup',endDrag);
  handle.addEventListener('pointercancel',endDrag);
  handle.addEventListener('keydown',function(e){
    if(done||auto) return;
    if(e.key==='ArrowRight'||e.key==='ArrowUp'){ e.preventDefault(); env.classList.remove('idle'); setP(p+.09); tipSpark(); if(p>=.985) complete(); }
    else if(e.key==='Enter'||e.key===' '){ e.preventDefault(); autoCut(); }
  });
  $('#skip').addEventListener('click',autoCut);

  /* ---------- reading ---------- */
  function armReveal(){
    var els=$$('.sheet,.pages .arrow'); els.forEach(function(e){ e.classList.remove('in'); });
    if(RM||!('IntersectionObserver' in window)) return;
    var io=new IntersectionObserver(function(es){
      es.forEach(function(en){ if(en.isIntersecting){ en.target.classList.add('in'); io.unobserve(en.target); } });
    },{rootMargin:'0px 0px 140px 0px',threshold:0});
    els.forEach(function(e){ io.observe(e); });
  }
  function onScroll(){
    var h=document.documentElement.scrollHeight-window.innerHeight;
    var v=h>0?Math.min(1,Math.max(0,window.scrollY/h)):0;
    prog.style.setProperty('--sp',v.toFixed(4));
  }
  window.addEventListener('scroll',onScroll,{passive:true});
  window.addEventListener('resize',onScroll);
  function reveal(){
    main.hidden=false; prog.hidden=false; window.scrollTo(0,0); armReveal(); onScroll();
    stage.classList.add('leaving');
    later(function(){ stage.hidden=true; },750*T);
  }

  $('#wish').addEventListener('click',function(e){
    $('#wishOut').innerHTML='<div class="big">Happy birthday, Nics.</div><p>May the whole month be yours to take.</p>';
    var r=e.currentTarget.getBoundingClientRect(); burst(r.left+r.width/2,r.top,40,1.3); rain(2800);
    $('#wish span').textContent='Wish again';
  });

  $('#again').addEventListener('click',function(){
    timers.forEach(clearTimeout); timers=[];
    done=false; auto=false; drag=null; p=P0v; setP(P0v);
    env.classList.remove('open'); env.classList.add('idle');
    tapeA.classList.remove('fall'); tapeB.classList.remove('fall');
    handle.classList.remove('gone','snip'); stage.classList.remove('opening');
    stage.hidden=false; void stage.offsetWidth; stage.classList.remove('leaving');
    $('#wishOut').innerHTML=''; $('#wish span').textContent='Make a wish';
    later(function(){ main.hidden=true; prog.hidden=true; window.scrollTo(0,0); },750*T);
  });
})();
</script>

